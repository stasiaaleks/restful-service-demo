{
  "info": {
    "name": "Articles RESTful Service",
    "description": "Run the collection in order + \"Create article\" saves the new id to {{articleId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002/api"
    },
    {
      "key": "articleId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "Get all articles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/articles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "articles"
              ]
            }
          }
        },
        {
          "name": "Create article",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('articleId', pm.response.json()._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/articles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "articles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mob Psycho 100: Power Is Not Everything\",\n  \"author\": \"Anastasiia Aleksieienko\",\n  \"content\": \"An overpowered psychic who just wants to be ordinary, and a show about growing up.\",\n  \"tags\": [\n    \"review\",\n    \"action\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get article",
          "event": [
            {
              "listen": "test",
